# Automated Threat Intelligence & Patch Advisor
# Copy to .env for local development. Never commit real secrets.
#
# All passwords and usernames below are LOCAL DEVELOPMENT credentials only.
# They are not suitable for any shared, staging, or production environment.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
TZ=UTC

# ---------------------------------------------------------------------------
# PostgreSQL (system of record) — LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_advisor
POSTGRES_USER=threat_advisor
POSTGRES_PASSWORD=threat_advisor_dev_change_me

# JDBC URL used by Spring Boot services
DATABASE_URL=jdbc:postgresql://localhost:5432/threat_advisor

# ---------------------------------------------------------------------------
# Redis (cache, idempotency locks, rate limiting — never source of truth)
# LOCAL DEVELOPMENT: no password
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Kafka (KRaft, no ZooKeeper)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_UI_PORT=8088

# ---------------------------------------------------------------------------
# Service ports (run locally outside Docker)
# ---------------------------------------------------------------------------
API_SERVICE_PORT=8080
INGESTION_SERVICE_PORT=8081
CORRELATION_SERVICE_PORT=8082
RISK_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
DASHBOARD_PORT=5173

# ---------------------------------------------------------------------------
# Spring profiles
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# ---------------------------------------------------------------------------
# Auth — LOCAL DEVELOPMENT in-memory users only. Replace with IdP later.
# ---------------------------------------------------------------------------
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin_change_me
LOCAL_ANALYST_USERNAME=analyst
LOCAL_ANALYST_PASSWORD=analyst_change_me
LOCAL_MANAGER_USERNAME=manager
LOCAL_MANAGER_PASSWORD=manager_change_me
LOCAL_VIEWER_USERNAME=viewer
LOCAL_VIEWER_PASSWORD=viewer_change_me

# ---------------------------------------------------------------------------
# OpenAI (Phase 3). AI_DEMO_MODE=true skips live API calls.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DEMO_MODE=true
AI_RAG_TOP_K=5
AI_MAX_AGENT_ITERATIONS=10

# Service-to-service URLs (Phase 5A investigation tools / BFF proxy)
CORRELATION_SERVICE_URL=http://localhost:8082
RISK_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084

# Vite dashboard local Basic auth (proxy only; not sent to the browser as a secret store)
VITE_API_USER=analyst
VITE_API_PASSWORD=analyst_change_me

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
